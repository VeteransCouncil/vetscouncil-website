# Copy this file to .env.local (for local dev) and set these same values
# as environment variables in your hosting provider (Vercel, Netlify, etc.)
# for the contact form to send email in production.

# The Gmail address the form sends FROM (can be highlandsvetscouncil@gmail.com itself,
# or a separate Gmail account you control).
GMAIL_USER=highlandsvetscouncil@gmail.com

# A Gmail "App Password" (NOT your normal Gmail password).
# Generate one at: https://myaccount.google.com/apppasswords
# Requires 2-Step Verification to be enabled on the Google account first.
GMAIL_APP_PASSWORD=your-16-character-app-password
